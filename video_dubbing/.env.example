# Bodhan API keys (issued per model in the Bodhan console). Placeholders only: never commit real keys.
BODHAN_TRANSCRIBE_KEY=your-indic-transcribe-key
BODHAN_TRANSLATE_KEY=your-indic-translate-key
BODHAN_SPEAK_KEY=your-indic-speak-key
# Optional: one key for all three models (used when a per-model key is not set)
# BODHAN_API_KEY=your-key

# Any OpenAI-compatible LLM. It only judges and edits English; it never writes Indian-language text.
# Leave unset to run with deterministic fallbacks (no LLM).
LLM_BASE_URL=https://your-llm-provider.example/v1
LLM_MODEL=your-model-name
LLM_API_KEY=your-llm-key

# Optional tuning
# BODHAN_DUB_CER_FAIL=0.35        # back-transcription error rate above which a line is retried
# BODHAN_DUB_WEB_DATA=./webdata   # where the web UI stores projects
